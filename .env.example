DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=kanban
DATABASE_USER=kanban
DATABASE_PASSWORD=kanban_dev
# Optional pool/connectivity settings. SSL verifies the server certificate when enabled.
# DATABASE_POOL_SIZE=10
# DATABASE_CONNECT_TIMEOUT_MS=5000
# DATABASE_SSL=false

API_PORT=3000
NODE_ENV=development
API_PREFIX=api
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug
# Generate a unique random value with at least 32 bytes, for example:
# openssl rand -base64 32
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
# Development/test always uses the in-memory fake mailer, never Resend.
RESEND_API_KEY=
MAIL_FROM="Kanvexa <no-reply@kanvexa.tech>"
PUBLIC_APP_URL=http://localhost:5173
# In-memory per-instance HTTP rate limit; Auth may use a stricter per-route policy.
# RATE_LIMIT_TTL_MS=60000
# RATE_LIMIT_MAX=120
# SWAGGER_ENABLED defaults to true outside production and false in production.
# SWAGGER_ENABLED=true
WEB_PORT=5173

# Frontend (public, client-safe values only; never put secrets in VITE_* variables)
VITE_API_BASE_URL=http://localhost:3000/api
