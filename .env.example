DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=kanban
DATABASE_USER=kanban
DATABASE_PASSWORD=kanban_dev
# Optional pool/connectivity settings. SSL verifies the server certificate when enabled.
# DATABASE_POOL_SIZE=10
# DATABASE_CONNECT_TIMEOUT_MS=5000
# DATABASE_SSL=false

API_PORT=3000
NODE_ENV=development
API_PREFIX=api
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug
# Generate a unique random value with at least 32 bytes, for example:
# openssl rand -base64 32
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
# Optional Web OAuth client ID. Empty disables Google while local auth still works.
# Must match VITE_GOOGLE_CLIENT_ID below; never provide a client secret.
GOOGLE_CLIENT_ID=
# Development defaults to fake. Set resend explicitly to test real local email.
# NODE_ENV=test always forces fake, including when the local .env enables Resend.
MAIL_TRANSPORT=fake
# Required with MAIL_TRANSPORT=resend; supply privately and never log/commit it.
RESEND_API_KEY=
MAIL_FROM="Kanvexa <no-reply@kanvexa.tech>"
PUBLIC_APP_URL=http://localhost:5173
# Empty disables invitation email (UNAVAILABLE). Configure only after #117's
# acceptance route handles #proof= safely and passes the end-to-end rollout gate.
WORKSPACE_INVITATION_ACCEPT_PATH=

# Development avatar bytes live only in bounded RAM; restart clears them.
# No AWS credentials needed. Use disabled to opt out; memory is rejected in production.
AVATAR_STORAGE_DRIVER=memory
AVATAR_S3_BUCKET=
AVATAR_S3_REGION=ap-southeast-1
AVATAR_S3_PREFIX=avatars/v1
# Fixed server limits: 5 MiB, 16 Mi pixels, 512px output, POST 60s, intent 5min.
# In-memory per-instance HTTP rate limit; Auth may use a stricter per-route policy.
# RATE_LIMIT_TTL_MS=60000
# RATE_LIMIT_MAX=120
# SWAGGER_ENABLED defaults to true outside production and false in production.
# SWAGGER_ENABLED=true
WEB_PORT=5173

# Frontend (public, client-safe values only; never put secrets in VITE_* variables)
VITE_API_BASE_URL=http://localhost:3000/api
VITE_GOOGLE_CLIENT_ID=
