{
  "name": "@kanban/backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "build": "nest build",
    "preview:verification-email": "pnpm build && node scripts/preview-verification-email.mjs",
    "preview:welcome-email": "pnpm build && node scripts/preview-welcome-email.mjs",
    "preview:workspace-invitation-email": "pnpm build && node scripts/preview-workspace-invitation-email.mjs",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathIgnorePatterns=e2e-spec",
    "test:e2e": "jest --runInBand --testPathPattern=e2e-spec",
    "test:cov": "jest --runInBand --coverage",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/database/data-source.ts",
    "test:database": "pnpm build && node test/database/database-foundation.integration.mjs",
    "test:phase2-integrity:database": "pnpm build && node test/database/phase2-integrity.integration.mjs",
    "test:workspaces:database": "pnpm build && node test/workspaces/workspaces.integration.mjs",
    "test:workspace-api:database": "pnpm build && node test/workspaces/workspace-api.integration.mjs",
    "test:workspace-members:database": "pnpm build && node test/workspaces/workspace-members-invitations.integration.mjs",
    "test:workspace-invitations:database": "pnpm build && node test/workspaces/workspace-members-invitations.integration.mjs --invitations-only",
    "test:board-access:database": "pnpm build && node test/workspaces/workspace-members-invitations.integration.mjs",
    "test:preferences:database": "pnpm build && node test/users/user-preferences.integration.mjs",
    "test:avatars:database": "pnpm build && node test/users/avatar.integration.mjs",
    "test:email-verification:database": "pnpm build && node test/auth/email-verification.integration.mjs",
    "test:google-auth:database": "pnpm build && node test/auth/google-auth.integration.mjs",
    "test:welcome-email:database": "pnpm build && node test/auth/welcome-email.integration.mjs",
    "test:password-security:database": "pnpm build && node test/auth/password-security.integration.mjs",
    "test:boards:database": "pnpm build && node test/boards/boards.integration.mjs",
    "test:board-members:database": "pnpm build && node test/board-members/board-members.integration.mjs",
    "test:columns:database": "pnpm build && node test/columns/columns.integration.mjs",
    "test:cards:database": "pnpm build && node test/cards/cards.integration.mjs",
    "test:comments:database": "pnpm build && node test/comments/comments.integration.mjs",
    "test:activities:database": "pnpm build && node test/activities/activities.integration.mjs",
    "test:realtime": "jest --runInBand --runTestsByPath test/realtime/realtime.e2e-spec.ts",
    "test:realtime:database": "node -r ts-node/register test/realtime/realtime.integration.mjs",
    "test:board-events:database": "node -r ts-node/register test/realtime/board-events/board-events.integration.mjs",
    "test:checklists:database": "pnpm build && node test/card-checklists/checklists.integration.mjs",
    "test:labels:database": "pnpm build && node test/labels/labels.integration.mjs",
    "test:card-dates:database": "pnpm build && node test/cards/dates/dates.integration.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1157.0",
    "@aws-sdk/s3-presigned-post": "^3.1157.0",
    "@kanban/shared": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.0",
    "@nestjs/websockets": "^11.0.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "dotenv": "^17.0.0",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.3.0",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.0.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.0",
    "resend": "^6.34.1",
    "rxjs": "^7.0.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.0.0",
    "typeorm": "^0.3.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "jest": "^29.0.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0"
  }
}
