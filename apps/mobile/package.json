{
  "name": "@kanban/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
  },
  "scripts": {
    "dev": "expo start --go",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "android:native": "expo run:android",
    "ios:native": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck",
    "eas-build-post-install": "pnpm --filter @kanban/shared build",
    "bundle:android": "expo export --platform android --output-dir dist/android --source-maps && node scripts/verify-native-bundle.mjs dist/android",
    "bundle:ios": "expo export --platform ios --output-dir dist/ios --source-maps && node scripts/verify-native-bundle.mjs dist/ios",
    "bundle:development": "expo export --platform android --dev --output-dir dist/development --source-maps && node scripts/verify-native-bundle.mjs dist/development",
    "test": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/*.test.mjs test/**/*.test.ts && jest --runInBand",
    "test:realtime:local": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/realtime/live-smoke.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.17",
    "@kanban/shared": "workspace:*",
    "@react-native-google-signin/google-signin": "16.1.5",
    "@tanstack/react-query": "5.90.21",
    "expo": "58.0.23",
    "expo-constants": "58.0.15",
    "expo-file-system": "58.0.13",
    "expo-linking": "58.0.16",
    "expo-network": "~58.0.5",
    "expo-router": "58.0.30",
    "expo-secure-store": "58.0.2",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "socket.io-client": "4.8.4"
  },
  "devDependencies": {
    "@expo/metro": "58.0.0",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "jest": "29.7.0",
    "jest-expo": "58.0.6",
    "test-renderer": "1.0.0",
    "typescript": "6.0.3"
  }
}
