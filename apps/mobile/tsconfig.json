{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["react", "react-native", "node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "gallery/**/*.tsx",
    "app.config.ts",
    "test/fixtures/**/*.ts"
  ]
}
