# Public REST configuration. Session verification runs on restore and after sign-in.
# HTTP is accepted only for local/LAN hosts in development (__DEV__) builds.
# Android Studio emulator -> development machine (not the emulator's localhost).
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000/api
# Socket.IO derives its validated origin from the API URL above.
# Physical Android: replace 10.0.2.2 with your development machine's LAN IPv4.
# EXPO_PUBLIC_* values are bundled into the app. Never put secrets/tokens here.

# Native Google Sign-In (MOB-09). Needs a development/preview build, not Expo Go.
# Web/server OAuth client ID: must equal the backend GOOGLE_CLIENT_ID (token audience).
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=123456789012-example.apps.googleusercontent.com
# iOS OAuth client ID (iOS only; also sets the iOS URL scheme at prebuild).
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=123456789012-exampleios.apps.googleusercontent.com
# Leave both unset to hide the Google action; email/password keeps working.
