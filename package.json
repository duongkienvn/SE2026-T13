{
  "name": "realtime-collaborative-kanban",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --filter @kanban/shared build && pnpm -r --parallel --filter @kanban/web --filter @kanban/api dev",
    "dev:web": "pnpm --filter @kanban/shared build && pnpm --filter @kanban/web dev",
    "dev:api": "pnpm --filter @kanban/shared build && pnpm --filter @kanban/api dev",
    "build": "pnpm -r build",
    "lint": "eslint apps packages",
    "test": "pnpm --filter @kanban/shared build && pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
