# Copy OUTSIDE the repository, e.g. /etc/kanvexa/production.env (chmod 600).
# Supply required blank values; Google IDs stay empty until the feature is enabled.
IMAGE_TAG=
BACKEND_IMAGE=kanvexa-backend
FRONTEND_IMAGE=kanvexa-frontend
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
JWT_SECRET=
# Optional public Web client ID; empty disables backend Google authentication.
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
MAIL_FROM="Kanvexa <no-reply@kanvexa.tech>"
PUBLIC_APP_URL=https://kanvexa.tech
# Keep empty until the frontend acceptance route is agreed, deployed and verified.
# See docs/tasks/backend/workspace-invitation-email-delivery.md before enabling.
WORKSPACE_INVITATION_ACCEPT_PATH=

# ACTION REQUIRED BY USER: docs/deployment/private-avatars.md before enabling s3.
# Default remains disabled until IAM, CORS, IMDSv2 and smoke checks are complete.
AVATAR_STORAGE_DRIVER=disabled
AVATAR_S3_BUCKET=kanvexa-avatars-prod-338534047400-ap-southeast-1-an
AVATAR_S3_REGION=ap-southeast-1
AVATAR_S3_PREFIX=avatars/v1
# Fixed server limits: 5 MiB, 16 Mi pixels, 512px output, POST 60s, intent 5min.
# AWS SDK uses the EC2 role; do not supply long-lived AWS keys here or in VITE_*.

# Fixed production topology in compose.prod.yml; these document runtime values.
# Change the Compose configuration deliberately if these must change.
NODE_ENV=production
API_PORT=3000
API_PREFIX=api
CORS_ORIGINS=https://kanvexa.tech
SWAGGER_ENABLED=false
LOG_LEVEL=info
TRUST_PROXY_HOPS=1
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_SSL=false
DATABASE_POOL_SIZE=5

# PUBLIC build-time value, embedded by Vite. Not a NestJS runtime variable.
VITE_API_BASE_URL=/api
# Used for local image builds; CD uses the GitHub repository variable of this name.
# Must match GOOGLE_CLIENT_ID on EC2. Changing runtime env cannot rebuild Vite.
VITE_GOOGLE_CLIENT_ID=
